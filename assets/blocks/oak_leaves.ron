// An oak canopy. Solid, and drops nothing (4's `drops: Nothing`) -- leaf
// decay and saplings are gameplay decisions the owner has not made
// (PHASE2_ARCHITECTURE.md 9), so neither is assumed here.
Material(
    name:   "cubara:oak_leaves",
    solid:  true,
    faces:  All("oak_leaves"),
    shapes: [Full],
    // Nothing, whatever you hold.
    drops:  Nothing,
    // Ticks of work at speed 1 (PHASE2_ARCHITECTURE.md 4.3). Absent would
    // mean unbreakable, so every shipped block declares one.
    hardness: Some(3),
)
