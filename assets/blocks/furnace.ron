// Smelts ore into ingots. Block 2.4 gives it its timer and slots (PHASE2 7).
Material(
    name:   "cubara:furnace",
    solid:  true,
    faces:  Sided(top: "furnace_top", side: "furnace_side", bottom: "furnace_top"),
    shapes: [Full],
    // Ticks of work at speed 1 (PHASE2_ARCHITECTURE.md 4.3), at 60 tps:
    // 2.25 s bare-handed, 1.1 s with a wooden pick. Absent would mean unbreakable, so every shipped
    // block declares one.
    hardness: Some(135),
    // Right-clicking opens its screen. A property of the block since block
    // 2.4c, replacing Game's name comparison.
    interact: Furnace,
)
