// Placeable planks, and the base crafting material.
Material(
    name:   "cubara:plank",
    solid:  true,
    faces:  All("plank"),
    shapes: [Full],
    // Ticks of work at speed 1 (PHASE2_ARCHITECTURE.md 4.3). Absent would
    // mean unbreakable, so every shipped block declares one.
    hardness: Some(15),
)
