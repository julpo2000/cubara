// The 3x3 grid. Decision A's whole point: the bench is a real milestone.
Material(
    name:   "cubara:crafting_bench",
    solid:  true,
    faces:  Sided(top: "bench_top", side: "bench_side", bottom: "plank"),
    shapes: [Full],
    // Ticks of work at speed 1 (PHASE2_ARCHITECTURE.md 4.3). Absent would
    // mean unbreakable, so every shipped block declares one.
    hardness: Some(15),
    // Right-clicking opens its screen. A property of the block since block
    // 2.4c, replacing Game's name comparison.
    interact: Bench,
)
