// Tier 2, and what iron ore requires.
//
// Takes cobble, not stone: block 2.4a made mined stone drop cubara:cobble,
// which is what the cobble item had been waiting for. A data change, no code.
Recipe(
    name:    "cubara:stone_pick",
    pattern: [
        "SSS",
        " T ",
        " T ",
    ],
    key: {
        'S': "cubara:cobble",
        'T': "cubara:stick",
    },
    output: (item: "cubara:stone_pick", count: 1),
)
